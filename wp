#!/bin/bash

# Configuration
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
WEALTHTRACK_DIR="$SCRIPT_DIR/../wealthtrack"
# Repo is named "file-importer" on GitHub; the local directory was renamed to
# "investracker" — always use the local dir name here, not the repo name.
CRYPTO_BACKEND_DIR="$SCRIPT_DIR/../investracker"
CRYPTO_FRONTEND_DIR="$SCRIPT_DIR/../importer-porfolio"
HEALTH_VAULT_DIR="$SCRIPT_DIR/../healthVault"
CV_GEN_DIR="$SCRIPT_DIR/../cv-generator"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

# Auto-detect Java 17 for Gradle/Spring Boot backend
ensure_java_17() {
    if [ -z "$JAVA_HOME" ] || [[ "$JAVA_HOME" == *"24"* ]]; then
        if command -v /usr/libexec/java_home >/dev/null 2>&1; then
            JAVA_17_HOME=$(/usr/libexec/java_home -v 17 2>/dev/null)
            if [ -n "$JAVA_17_HOME" ]; then
                export JAVA_HOME="$JAVA_17_HOME"
                log "Using Java 17 at $JAVA_HOME"
            fi
        fi
    fi
}

# Colors for logging
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

log() {
    echo -e "${BLUE}[wp]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[wp] WARN: $1${NC}"
}

error() {
    echo -e "${RED}[wp] ERROR: $1${NC}"
    exit 1
}

cleanup() {
    echo ""
    log "Shutting down all processes..."
    # Kill background processes started by this script
    pkill -P $$ 2>/dev/null
    exit
}
trap cleanup SIGINT SIGTERM

check_docker() {
    if ! docker info > /dev/null 2>&1; then
        warn "Docker is not running. Some services might fail if they depend on local containers."
    fi
    # Use 'docker compose' (v2) by default, fallback to 'docker-compose' (v1) if needed
    if docker compose version > /dev/null 2>&1; then
        DOCKER_COMPOSE="docker compose -f $COMPOSE_FILE"
    elif docker-compose version > /dev/null 2>&1; then
        DOCKER_COMPOSE="docker-compose -f $COMPOSE_FILE"
    else
        warn "Neither 'docker compose' nor 'docker-compose' found."
    fi
}

check_wealthtrack_env() {
    if [ ! -f "$WEALTHTRACK_DIR/.env.local" ]; then
        warn "wealthtrack/.env.local not found. Auth and DB might fail."
    else
        # Check for AUTH_SECRET specifically since it caused a log error
        if ! grep -q "AUTH_SECRET" "$WEALTHTRACK_DIR/.env.local"; then
            warn "AUTH_SECRET missing in wealthtrack/.env.local. NextAuth will fail."
        fi
    fi
}

start_wealthtrack_db() {
    log "Ensuring WealthTrack DB is running..."
    if [[ $($DOCKER_COMPOSE ps wealthtrack-db --format "{{.State}}") != "running" ]]; then
        log "Starting WealthTrack DB container..."
        $DOCKER_COMPOSE up -d wealthtrack-db
    else
        log "WealthTrack DB is already running."
    fi
}

start_crypto_db() {
    log "Ensuring Crypto Tracker DB is running..."
    if [[ $($DOCKER_COMPOSE ps crypto-db --format "{{.State}}") != "running" ]]; then
        log "Starting Crypto DB (Postgres on 5435) + Redis (6379)..."
        $DOCKER_COMPOSE up -d crypto-db crypto-redis
    else
        log "Crypto DB is already running."
    fi
}

run_wealthtrack() {
    check_docker
    check_wealthtrack_env
    start_wealthtrack_db
    
    log "Starting WealthTrack dev server on port 3000..."
    cd "$WEALTHTRACK_DIR"
    pnpm run dev
}

run_crypto() {
    check_docker
    start_crypto_db
    ensure_java_17
    
    log "Starting Backend API (9080) and UI (3001)..."
    (
        cd "$CRYPTO_BACKEND_DIR"
        ./gradlew bootRun | sed "s/^/$(echo -e $GREEN)[CRYPTO-API]$(echo -e $NC) /"
    ) &
    
    (
        cd "$CRYPTO_FRONTEND_DIR"
        BROWSER=none PORT=3001 pnpm start | sed "s/^/$(echo -e $CYAN)[CRYPTO-UI]$(echo -e $NC) /"
    ) &
    
    wait
}

run_all() {
    check_docker
    check_wealthtrack_env
    ensure_java_17
    
    log "Pre-starting databases..."
    start_wealthtrack_db
    start_crypto_db
    
    log "Starting application servers..."
    
    # WealthTrack
    (
        cd "$WEALTHTRACK_DIR"
        pnpm run dev | sed "s/^/$(echo -e $MAGENTA)[WEALTH]$(echo -e $NC) /"
    ) &
    
    # Crypto Tracker Backend
    (
        cd "$CRYPTO_BACKEND_DIR"
        ./gradlew bootRun | sed "s/^/$(echo -e $GREEN)[CRYPTO-API]$(echo -e $NC) /"
    ) &
    
    # HealthVault
    (
        cd "$HEALTH_VAULT_DIR"
        pnpm run dev | sed "s/^/$(echo -e $YELLOW)[HEALTH]$(echo -e $NC) /"
    ) &
    
    wait
}

run_health_vault() {
    log "Starting HealthVault dev server on port 3002..."
    cd "$HEALTH_VAULT_DIR"
    pnpm run dev
}

run_cv_gen() {
    log "Starting CV Generator dev server on port 5173..."
    cd "$CV_GEN_DIR"
    pnpm i && pnpm run dev
}

run_docker() {
    check_docker
    log "Starting all services via Docker Compose..."
    $DOCKER_COMPOSE up -d --build
}

case "$1" in
    run)
        case "$2" in
            wealthtrack) run_wealthtrack ;;
            crypto-tracker) run_crypto ;;
            cv-gen) run_cv_gen ;;
            health-vault) run_health_vault ;;
            all) run_all ;;
            docker) run_docker ;;
            *) echo "Usage: $0 run {wealthtrack|crypto-tracker|cv-gen|health-vault|all|docker}" ;;
        esac
        ;;
    *)
        echo "Usage: $0 run {wealthtrack|crypto-tracker|cv-gen|health-vault|all|docker}"
        exit 1
        ;;
esac
