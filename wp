#!/bin/bash

# Enables job control so every `&` background job gets its own process
# group — needed so cleanup() can kill a service's whole process tree (e.g.
# gradlew's JVM), not just the immediate subshell.
set -m

# Configuration
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
WEALTHTRACK_DIR="$SCRIPT_DIR/../wealthtrack"
# Repo is named "file-importer" on GitHub; the local directory was renamed to
# "investracker" — always use the local dir name here, not the repo name.
CRYPTO_BACKEND_DIR="$SCRIPT_DIR/../investracker"
CRYPTO_FRONTEND_DIR="$SCRIPT_DIR/../importer-porfolio"
HEALTH_VAULT_DIR="$SCRIPT_DIR/../healthVault"
CV_GEN_DIR="$SCRIPT_DIR/../cv-generator"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

# Auto-detect Java 17 for Gradle/Spring Boot backend
ensure_java_17() {
    if [ -z "$JAVA_HOME" ] || [[ "$JAVA_HOME" == *"24"* ]]; then
        if command -v /usr/libexec/java_home >/dev/null 2>&1; then
            JAVA_17_HOME=$(/usr/libexec/java_home -v 17 2>/dev/null)
            if [ -n "$JAVA_17_HOME" ]; then
                export JAVA_HOME="$JAVA_17_HOME"
                log "Using Java 17 at $JAVA_HOME"
            fi
        fi
    fi
}

# Colors for logging
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

log() {
    echo -e "${BLUE}[wp]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[wp] WARN: $1${NC}"
}

error() {
    echo -e "${RED}[wp] ERROR: $1${NC}"
    exit 1
}

cleanup() {
    echo ""
    log "Shutting down all processes..."
    # Kill each tracked service's whole process group (covers e.g. gradlew's
    # JVM, not just the subshell wrapping it — see `set -m` above).
    for pid in "${BG_PIDS[@]}"; do
        kill -TERM -- "-$pid" 2>/dev/null
    done
    # Anything else this script spawned directly (e.g. a foreground docker
    # compose call) that isn't in BG_PIDS.
    pkill -P $$ 2>/dev/null
    exit
}
trap cleanup SIGINT SIGTERM

# ----------------------------------------------------------------------------
# Quiet process orchestration: run a dev server in the background with its
# output going to a log file instead of the terminal, print one status line
# per service ("starting" -> "up" or "failed"), and only dump the raw log
# when something actually goes wrong.
# ----------------------------------------------------------------------------
LOG_DIR="$SCRIPT_DIR/.wp-logs"
mkdir -p "$LOG_DIR"

# Track every background PID/name this run started, so the final `wait` at
# the end of each run_* function blocks on all of them (Ctrl+C still works
# via the trap above) without re-printing their output.
BG_PIDS=()
BG_NAMES=()

# Poll 127.0.0.1:$1 until it accepts a connection, or $2 seconds pass.
# Prints a short "still waiting" note every 10s so a slow boot doesn't look
# frozen. Returns 0 once the port is open, 1 on timeout.
wait_for_port() {
    local port="$1"
    local timeout="${2:-60}"
    local waited=0
    while ! (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; do
        sleep 1
        waited=$((waited + 1))
        if [ "$waited" -ge "$timeout" ]; then
            return 1
        fi
        if [ $((waited % 10)) -eq 0 ]; then
            echo -e "${YELLOW}[wp]${NC} …still waiting on port ${port} (${waited}s)"
        fi
    done
    exec 3<&- 3>&- 2>/dev/null
    return 0
}

# start_service <name> <dir> <command> <port> <timeout_seconds>
# Runs `command` in `dir` in the background (output -> $LOG_DIR/<name>.log),
# waits for `port` to open, and prints a single up/failed status line. On
# failure (timeout, or the process exited before the port ever opened) it
# prints the log so the actual error is visible.
start_service() {
    local name="$1" dir="$2" cmd="$3" port="$4" timeout="${5:-60}"
    local logfile="$LOG_DIR/${name}.log"
    : > "$logfile"

    log "Starting ${name}..."
    (
        cd "$dir" || exit 1
        eval "$cmd"
    ) > "$logfile" 2>&1 &
    local pid=$!
    BG_PIDS+=("$pid")
    BG_NAMES+=("$name")

    if wait_for_port "$port" "$timeout"; then
        echo -e "${GREEN}✔${NC} ${name} is up (port ${port})"
    elif kill -0 "$pid" 2>/dev/null; then
        echo -e "${RED}✘${NC} ${name} did not open port ${port} within ${timeout}s — last log lines:"
        tail -n 30 "$logfile"
    else
        echo -e "${RED}✘${NC} ${name} exited before it became ready — last log lines:"
        tail -n 30 "$logfile"
    fi
}

# Block until every service started this run exits (so Ctrl+C via the trap
# above still tears everything down); print where the logs are first.
wait_for_all_services() {
    if [ "${#BG_NAMES[@]}" -gt 0 ]; then
        log "All requested services processed. Logs: ${LOG_DIR}/<service>.log (tail -f to follow one live). Ctrl+C to stop everything."
    fi
    wait
}

check_docker() {
    if ! docker info > /dev/null 2>&1; then
        warn "Docker is not running. Some services might fail if they depend on local containers."
    fi
    # Use 'docker compose' (v2) by default, fallback to 'docker-compose' (v1) if needed
    if docker compose version > /dev/null 2>&1; then
        DOCKER_COMPOSE="docker compose -f $COMPOSE_FILE"
    elif docker-compose version > /dev/null 2>&1; then
        DOCKER_COMPOSE="docker-compose -f $COMPOSE_FILE"
    else
        warn "Neither 'docker compose' nor 'docker-compose' found."
    fi
}

check_wealthtrack_env() {
    if [ ! -f "$WEALTHTRACK_DIR/.env.local" ]; then
        warn "wealthtrack/.env.local not found. Auth and DB might fail."
    else
        # Check for AUTH_SECRET specifically since it caused a log error
        if ! grep -q "AUTH_SECRET" "$WEALTHTRACK_DIR/.env.local"; then
            warn "AUTH_SECRET missing in wealthtrack/.env.local. NextAuth will fail."
        fi
    fi
}

start_wealthtrack_db() {
    log "Ensuring WealthTrack DB is running..."
    if [[ $($DOCKER_COMPOSE ps wealthtrack-db --format "{{.State}}") != "running" ]]; then
        log "Starting WealthTrack DB container..."
        $DOCKER_COMPOSE up -d wealthtrack-db
    else
        log "WealthTrack DB is already running."
    fi
}

start_crypto_db() {
    log "Ensuring Crypto Tracker DB is running..."
    if [[ $($DOCKER_COMPOSE ps crypto-db --format "{{.State}}") != "running" ]]; then
        log "Starting Crypto DB (Postgres on 5435) + Redis (6379)..."
        $DOCKER_COMPOSE up -d crypto-db crypto-redis
    else
        log "Crypto DB is already running."
    fi
}

run_wealthtrack() {
    check_docker
    check_wealthtrack_env
    start_wealthtrack_db

    start_service "wealthtrack" "$WEALTHTRACK_DIR" "pnpm run dev" 3000 60
    wait_for_all_services
}

run_crypto() {
    check_docker
    start_crypto_db
    ensure_java_17

    # Gradle's first boot (daemon warmup + compile) is much slower than a
    # dev-server start, so it gets a longer timeout.
    start_service "crypto-api" "$CRYPTO_BACKEND_DIR" "./gradlew bootRun" 9080 120
    start_service "crypto-ui" "$CRYPTO_FRONTEND_DIR" "BROWSER=none PORT=3001 pnpm start" 3001 60

    wait_for_all_services
}

run_all() {
    check_docker
    check_wealthtrack_env
    ensure_java_17

    log "Pre-starting databases..."
    start_wealthtrack_db
    start_crypto_db

    start_service "wealthtrack" "$WEALTHTRACK_DIR" "pnpm run dev" 3000 60
    start_service "crypto-api" "$CRYPTO_BACKEND_DIR" "./gradlew bootRun" 9080 120
    start_service "crypto-ui" "$CRYPTO_FRONTEND_DIR" "BROWSER=none PORT=3001 pnpm start" 3001 60
    start_service "health-vault" "$HEALTH_VAULT_DIR" "pnpm run dev" 3002 60

    wait_for_all_services
}

run_health_vault() {
    start_service "health-vault" "$HEALTH_VAULT_DIR" "pnpm run dev" 3002 60
    wait_for_all_services
}

run_cv_gen() {
    (cd "$CV_GEN_DIR" && pnpm i) || error "pnpm install failed for cv-generator — see output above."
    start_service "cv-gen" "$CV_GEN_DIR" "pnpm run dev" 5173 60
    wait_for_all_services
}

run_docker() {
    check_docker
    log "Building and starting all services via Docker Compose (this can take a while on the first build)..."
    local logfile="$LOG_DIR/docker-compose.log"
    if $DOCKER_COMPOSE up -d --build > "$logfile" 2>&1; then
        echo -e "${GREEN}✔${NC} Docker Compose stack is up:"
        $DOCKER_COMPOSE ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"
        log "Full build/start log: ${logfile}"
    else
        echo -e "${RED}✘${NC} docker compose up --build failed — last log lines:"
        tail -n 60 "$logfile"
        return 1
    fi
}

case "$1" in
    run)
        case "$2" in
            wealthtrack) run_wealthtrack ;;
            crypto-tracker) run_crypto ;;
            cv-gen) run_cv_gen ;;
            health-vault) run_health_vault ;;
            all) run_all ;;
            docker) run_docker ;;
            *) echo "Usage: $0 run {wealthtrack|crypto-tracker|cv-gen|health-vault|all|docker}" ;;
        esac
        ;;
    *)
        echo "Usage: $0 run {wealthtrack|crypto-tracker|cv-gen|health-vault|all|docker}"
        exit 1
        ;;
esac
