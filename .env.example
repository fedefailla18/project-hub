# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Required: OpenAI API key for the smart-tier model (gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Optional: override the smart-tier model (default: gpt-4o-mini)
HUB_SMART_MODEL=gpt-4o-mini

# Docker Model Runner is detected automatically at startup.
# No key needed — it uses api_key="docker" internally.
# If unreachable, the service falls back to gpt-4o-mini for all tiers.
